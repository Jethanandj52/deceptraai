PORT
NODE_ENV
CORS_ORIGIN


# MongoDB connection string. Use a local mongod or MongoDB Atlas.
MONGO_URI
# JWT secret + expiry for recruiter/admin login sessions
JWT_SECRET
JWT_EXPIRES_IN

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN

# Set to "true" if ffmpeg is installed on this machine (recommended) so
# non-WAV candidate audio (webm/ogg from the browser MediaRecorder) can be
# converted to WAV before voice-feature extraction. If false/missing, a
# lower-fidelity fallback analysis is used instead.
FFMPEG_AVAILABLE
SESSION_SECRET
 
EMAIL_USER
EMAIL_PASS
CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET
FRONTEND_URL